# Normalize to LF in the repository, check out native per platform, so the two
# machines don't produce whole-file diffs just from line endings.
* text=auto

# PowerShell is happiest with CRLF on Windows.
*.ps1 text eol=crlf

# Binary — never touch, never try to diff.
*.png binary
*.pdf binary

# Large binaries live in Git LFS (voice models and background videos).
*.pth filter=lfs diff=lfs merge=lfs -text
*.index filter=lfs diff=lfs merge=lfs -text
videos/*.mp4 filter=lfs diff=lfs merge=lfs -text
videos/*.webm filter=lfs diff=lfs merge=lfs -text
