# Copy this file to ".env" and fill in your key.
# Get a Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Optional: override the model used for AI features.
# gemini-flash-latest is fast and cheap; gemini-pro-latest is more capable.
RPM_MODEL=gemini-flash-latest

# Optional: host/port for the local server.
RPM_HOST=127.0.0.1
RPM_PORT=8000
